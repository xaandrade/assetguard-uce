{
  "compilerOptions": {
    "target": "ESNext",
    "module": "commonjs",
    "lib": ["es6", "dom"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "experimentalDecorators": true,      // <--- AGREGA ESTA
    "emitDecoratorMetadata": true,      // <--- AGREGA ESTA
    "types": ["jest", "node"],
    "baseUrl": "./",
    "rootDir": "./"
  },
  "include": ["src/**/*", "inventory.spec.ts"], 
  "exclude": ["node_modules"]
}